---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { waLink, quoteMessage } from '../lib/whatsapp';
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import ProjectGrid from './ProjectGrid.astro';
import FaqList from './FaqList.astro';
import CtaBand from './CtaBand.astro';

interface Props { entry: any; crumbs: { name: string; path: string }[] }
const { entry, crumbs } = Astro.props;
const d = entry.data;
const services = (await getCollection('services', (s) => s.data.kind === 'service' && s.data.category === d.category)).sort((a, b) => a.data.order - b.data.order);
const wa = waLink(quoteMessage({ service: d.name, path: Astro.url.pathname }));
---
<div class="mx-auto max-w-7xl px-4 pt-8 md:px-8">
  <Breadcrumbs crumbs={crumbs} />
  <h1 class="mt-6 max-w-3xl text-5xl md:text-6xl">{d.title}</h1>
  <p class="mt-5 max-w-[65ch] text-lg text-ink-soft md:text-xl">{d.answer}</p>
  <div class="mt-5 grid max-w-[65ch] gap-4"><slot /></div>
  <div class="mt-7"><Button href={wa} variant="accent" data-service={d.name}>Get a free quote</Button></div>

  <ul class:list={['mt-12 grid gap-5 sm:grid-cols-2', services.length === 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-3']}>
    {services.map((s, i) => {
      // 4, 7 or 10 cards: the first card spans the full row so every later row is complete.
      const lead = i === 0 && services.length > 3 && services.length % 3 === 1;
      const oddTail = (services.length - (services.length % 3 === 1 ? 1 : 0)) % 2 === 1 && i === services.length - 1;
      return (
        <li class:list={['wire-hover group overflow-hidden rounded-[var(--radius-card)] border border-line bg-card', lead && 'sm:col-span-2 lg:col-span-3', oddTail && 'sm:max-lg:col-span-2']}>
          <a href={`/${s.id}/`} class="block h-full">
            <Picture src={s.data.hero} alt={s.data.heroAlt} widths={[400, 800, 1200]} sizes={lead ? '100vw' : '(min-width: 1024px) 33vw, 50vw'} formats={['avif']} fallbackFormat="webp" class:list={['w-full object-cover transition-transform duration-500 ease-[var(--ease-out-quint)] group-hover:scale-[1.03]', lead ? 'aspect-[16/7]' : 'aspect-[16/10]']} />
            <div class="p-5">
              <h2 class="text-xl font-semibold group-hover:text-brand">{s.data.name}</h2>
              <p class="mt-2 text-ink-soft">{s.data.description}</p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>

  {d.alsoAvailable.length > 0 && (
    <section class="py-14">
      <h2 class="text-4xl md:text-5xl">Also available</h2>
      <p class="mt-3 max-w-[65ch] text-ink-soft">Not listed above? Message us on WhatsApp and we will tell you if we can do it.</p>
      <ul class="mt-6 flex flex-wrap gap-3">
        {d.alsoAvailable.map((a: string) => (
          <li><a href={waLink(quoteMessage({ service: a, path: Astro.url.pathname }))} class="inline-block rounded-full border border-line bg-card px-4 py-2 hover:border-brand">{a}</a></li>
        ))}
      </ul>
    </section>
  )}

  <ProjectGrid heading="Recent work" limit={6} />
  <FaqList faqs={d.faqs} />
</div>
<CtaBand service={d.name} />
