---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';

interface Props { image: ImageMetadata; imageAlt: string }
const { image, imageAlt } = Astro.props;
const wa = waLink(quoteMessage({ path: '/' }));
// Only confirmed facts. A rating joins this row once a real Google rating is set in site.ts.
const trust = [
  site.rating && { big: String(site.rating.value), small: 'Google rating' },
  { big: '10+', small: 'years' },
  site.freeInstallation && { big: 'Free', small: 'installation' },
  { big: 'On-site', small: 'measurement' },
].filter(Boolean) as { big: string; small: string }[];
---
<section class="bg-brand-deep text-white">
  <div class="mx-auto grid max-w-7xl items-stretch lg:min-h-[640px] lg:grid-cols-[45fr_55fr] lg:gap-14 lg:px-8 lg:pb-16 lg:pt-28">
    <div class="flex flex-col justify-center px-4 pb-8 pt-24 md:px-8 lg:p-0">
      <p class="rise text-xs font-semibold uppercase tracking-[0.18em] text-white/70" style="--i:0">Hyderabad home safety</p>
      <h1 class="rise mt-4 text-[2.5rem] font-bold leading-[1.05] sm:text-5xl lg:text-[3.5rem]" style="--i:1">Invisible grills and safety nets for Hyderabad homes</h1>
      <p class="rise mt-4 max-w-[46ch] text-lg text-white/80" style="--i:2">Protect balconies, children and pets without blocking the view. Professional installation across Hyderabad and Secunderabad.</p>
      <div class="rise mt-6 grid gap-3 sm:flex sm:flex-wrap lg:mt-8" style="--i:3">
        <a href={wa} class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-7 font-semibold text-accent-ink transition-transform duration-300 active:scale-[0.98]">Get a free quote</a>
        <a href={telLink()} class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/30 px-7 font-semibold transition-colors hover:bg-white/10">Call {site.phoneDisplay.replace('+91 ', '')}</a>
      </div>
      <div class="rise mt-8" style="--i:4">
        <div class="h-px w-12 bg-accent"></div>
        <p class="mt-4 text-sm text-white/65">Professional installation across Hyderabad</p>
        <ul class="mt-3 grid grid-cols-3 gap-x-4 gap-y-3 sm:flex sm:flex-wrap sm:gap-x-10">
          {trust.map((t) => (
            <li class="leading-tight"><span class="block text-xl font-bold">{t.big}</span><span class="text-sm text-white/65">{t.small}</span></li>
          ))}
        </ul>
        <p class="mt-4 text-sm italic text-white/50">Unobstructed views. Uncompromised safety.</p>
      </div>
    </div>
    <div class="px-4 pb-10 md:px-8 lg:p-0">
      <Picture src={image} alt={imageAlt} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 55vw, 100vw" formats={['avif']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full rounded-3xl object-cover lg:aspect-auto lg:h-full lg:min-h-[28rem]" />
    </div>
  </div>
</section>
