---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import markLight from '../assets/brand/logo-mark-light.png';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';

interface Props { service?: string; area?: string }
const { service, area } = Astro.props;
const here = Astro.url.pathname;
const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const hubs = all.filter((s) => s.data.kind === 'hub');
const wa = waLink(quoteMessage({ service, area, path: here }));
---
{/* Zero-height sticky wrapper: the glass bar floats over the page without taking layout space. */}
<header class="sticky top-0 z-30 h-0">
  <div class="mx-auto max-w-7xl px-3 pt-3 md:px-6">
    <div class="flex h-14 items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-900/80 px-4 text-white shadow-lg shadow-black/20 backdrop-blur-md">
      <a href="/" class="flex items-center gap-2.5 whitespace-nowrap text-base font-bold tracking-tight sm:text-lg" aria-label={`${site.name} home`}>
        <Image src={markLight} alt="" width={64} height={64} loading="eager" class="size-9" />
        {site.name}
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
        {site.sections.map((n) => (
          <a href={n.href} data-spy={n.id} class="rounded-full px-3 py-1.5 text-sm font-medium text-white/75 transition-colors hover:text-white aria-[current=true]:bg-white/10 aria-[current=true]:text-white">{n.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href={telLink()} data-service={service} class="hidden items-center gap-2 rounded-full border border-white/15 px-3 py-1.5 text-sm font-semibold xl:flex">
          <Icon name="ph:phone-duotone" class="size-4 text-accent" />{site.phoneDisplay}
        </a>
        <a href={wa} data-service={service} data-area={area} class="hidden items-center gap-2 rounded-full bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-transform active:scale-[0.97] sm:inline-flex">
          <Icon name="ph:whatsapp-logo-duotone" class="size-5" />WhatsApp
        </a>
        <button popovertarget="menu" class="grid size-10 place-items-center rounded-full border border-white/15 lg:hidden" aria-label="Open menu">
          <Icon name="ph:list-bold" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</header>

{/* Native popover: renders in the top layer, so the glass bar above cannot clip it. */}
<div id="menu" popover class="m-0 size-full max-h-none max-w-none overflow-y-auto border-0 bg-brand-deep p-6 text-white">
  <div class="flex items-center justify-between">
    <span class="flex items-center gap-2.5 text-lg font-bold"><Image src={markLight} alt="" width={64} height={64} class="size-8" />{site.name}</span>
    <button popovertarget="menu" popovertargetaction="hide" class="grid size-10 place-items-center rounded-full border border-white/20" aria-label="Close menu">
      <Icon name="ph:x-bold" class="size-5" />
    </button>
  </div>
  <ul class="mt-8 grid gap-7 pb-24">
    {hubs.map((h) => (
      <li>
        <a href={`/${h.id}/`} class="text-xl font-bold">{h.data.name}</a>
        <ul class="mt-2 grid gap-0.5">
          {all.filter((s) => s.data.kind === 'service' && s.data.category === h.data.category).map((s) => (
            <li><a href={`/${s.id}/`} class="block py-2 text-white/70">{s.data.name}</a></li>
          ))}
        </ul>
      </li>
    ))}
    <li class="grid gap-1 border-t border-white/10 pt-5">
      {site.nav.filter((n) => ['Projects', 'Areas', 'Contact'].includes(n.label)).map((n) => (
        <a href={n.href} class="py-2 text-lg font-semibold">{n.label}</a>
      ))}
    </li>
  </ul>
</div>

<script>
  // Scroll-spy: marks the nav link of the section in view. No-op on pages without these sections.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const targets = links.map((l) => document.getElementById(l.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.spy === e.target.id)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
  // Close the menu after tapping a link inside it.
  document.getElementById('menu')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) (document.getElementById('menu') as HTMLElement).hidePopover();
  });
</script>
