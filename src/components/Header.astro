---
// "The Rail": transparent over a dark hero, solid night after 80px (or from the start on paper pages).
// A 1px steel line runs along the bottom with an amber bead that slides along it as you scroll.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import markLight from '../assets/brand/logo-mark-light.png';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';

interface Props { service?: string; area?: string; darkHero?: boolean }
const { service, area, darkHero = false } = Astro.props;
const here = Astro.url.pathname;
const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const hubs = all.filter((s) => s.data.kind === 'hub');
const wa = waLink(quoteMessage({ service, area, path: here }));
const groups = hubs.map((h) => ({ hub: h, items: all.filter((s) => s.data.kind === 'service' && s.data.listed && s.data.category === h.data.category) }));
// Preview photos for the mega menu (small, lazy, only shown while hovering a service).
const previews = new Map<string, string>();
for (const s of all) previews.set(s.id, (await getImage({ src: s.data.hero, width: 480, format: 'webp', quality: 60 })).src);
const links = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Areas', href: '/areas/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="fixed inset-x-0 top-0 z-30" data-site-header data-solid={darkHero ? 'false' : 'true'}>
  <div class="rail-bar relative text-white transition-colors duration-300">
    <div class="mx-auto flex h-[68px] max-w-7xl items-center justify-between gap-4 px-4 md:px-8">
      <a href="/" class="flex min-h-11 items-center gap-2.5 whitespace-nowrap" aria-label={`${site.name} home`}>
        <Image src={markLight} alt="" width={64} height={64} loading="eager" class="size-9" />
        <span class="leading-none"><span class="block font-display text-[1.65rem]">Steven</span><span class="mono-tag mt-1 block !text-[0.62rem] tracking-[0.2em] text-white/70">Invisible Grills</span></span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
        <div class="group">
          <button type="button" aria-haspopup="true" class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-sm font-medium text-white/85 transition-colors hover:text-white group-focus-within:text-white">
            Our services <Icon name="ph:caret-down-bold" class="size-3.5 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180" />
          </button>
          {/* The Net Map: four groups joined by one steel line, with a photo preview of the hovered service. */}
          <div class="invisible absolute inset-x-0 top-full -translate-y-1 border-t border-white/10 bg-night opacity-0 shadow-2xl shadow-black/40 transition-[opacity,transform] duration-300 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
            <div class="relative mx-auto max-w-7xl px-8 py-10">
              <div class="mono-tag mb-6 flex items-center gap-3 text-dusk">Our services <span class="h-px flex-1 bg-white/15"></span> 19 services in 4 groups</div>
              <div class="grid grid-cols-4 gap-8 pr-[27%]">
                {groups.map(({ hub, items }) => (
                  <div class="relative border-t border-steel/40 pt-5">
                    <span class="absolute -top-[4px] left-0 size-[7px] rounded-full bg-dusk"></span>
                    <a href={`/${hub.id}/`} class="font-display text-2xl text-white hover:text-dusk">{hub.data.name}</a>
                    <p class="mono-tag mt-1 text-white/45">{items.length} services</p>
                    <ul class="mt-4 grid gap-0.5">
                      {items.map((s) => (
                        <li class="group/s">
                          <a href={`/${s.id}/`} class="block rounded px-2 py-1.5 text-[0.95rem] text-white/70 transition-colors hover:bg-white/5 hover:text-white focus-visible:bg-white/5 focus-visible:text-white">{s.data.name}</a>
                          <div class="pointer-events-none absolute right-8 top-[5.5rem] hidden w-[24%] group-hover/s:block group-focus-within/s:block">
                            <img src={previews.get(s.id)} alt="" width="480" height="300" loading="lazy" decoding="async" class="crop-marks h-[220px] w-full object-cover" />
                            <p class="mono-tag mt-3 text-dusk">{s.data.name} · free install</p>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <p class="mono-tag absolute right-8 top-[5.5rem] w-[24%] text-white/35">Hover a service to preview</p>
            </div>
          </div>
        </div>
        {links.map((n) => (
          <a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined} class="inline-flex min-h-11 items-center rounded-full px-3 text-sm font-medium text-white/85 transition-colors hover:text-white aria-[current=page]:text-dusk">{n.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href={telLink()} data-service={service} class="mono-tag hidden min-h-11 items-center gap-2 rounded-full border border-white/20 px-4 !text-[0.75rem] xl:flex">
          <Icon name="ph:phone-duotone" class="size-4 text-dusk" />{site.phoneDisplay}
        </a>
        <a href={wa} data-service={service} data-area={area} class="hidden min-h-11 items-center gap-2 rounded-full bg-dusk px-5 text-sm font-semibold text-night transition-transform active:scale-[0.97] sm:inline-flex">
          <Icon name="ph:whatsapp-logo-duotone" class="size-5" />WhatsApp
        </a>
        <button popovertarget="menu" class="grid size-11 place-items-center rounded-full border border-white/20 lg:hidden" aria-label="Open menu">
          <Icon name="ph:list-bold" class="size-5" />
        </button>
      </div>
    </div>
    {/* The rail itself, and the bead that rides it. */}
    <div class="absolute inset-x-0 bottom-0 h-px bg-steel/30" aria-hidden="true">
      <span class="rail-bead absolute -top-[2.5px] left-0 size-1.5 rounded-full bg-dusk shadow-[0_0_8px_#F2A541]"></span>
    </div>
  </div>
</header>

{/* Native popover: renders in the top layer, so nothing can clip it. */}
<div id="menu" popover class="m-0 size-full max-h-none max-w-none overflow-y-auto border-0 bg-night p-5 text-white">
  <div class="flex items-center justify-between">
    <span class="flex items-center gap-2.5"><Image src={markLight} alt="" width={64} height={64} class="size-9" /><span class="leading-none"><span class="block font-display text-[1.65rem]">Steven</span><span class="mono-tag mt-1 block !text-[0.62rem] tracking-[0.2em] text-white/70">Invisible Grills</span></span></span>
    <button popovertarget="menu" popovertargetaction="hide" class="grid size-11 place-items-center rounded-full border border-white/20" aria-label="Close menu">
      <Icon name="ph:x-bold" class="size-5" />
    </button>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-2">
    <a href={telLink()} class="flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/25 font-semibold"><Icon name="ph:phone-duotone" class="size-5 text-dusk" />Call now</a>
    <a href={wa} class="flex min-h-12 items-center justify-center gap-2 rounded-full bg-dusk font-semibold text-night"><Icon name="ph:whatsapp-logo-duotone" class="size-5" />Get a quote</a>
  </div>

  <ul class="mt-5 grid grid-cols-2 gap-2">
    {links.map((n) => (
      <li><a href={n.href} class="flex min-h-12 items-center rounded border border-white/10 bg-white/5 px-4 font-semibold">{n.label}</a></li>
    ))}
  </ul>

  <p class="mono-tag mb-2 mt-8 text-white/55">Our services</p>
  <div class="grid gap-2 pb-24">
    {groups.map(({ hub, items }) => (
      <details name="menu-group" class="group rounded border border-white/10 bg-white/5 px-4">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 font-semibold">
          <span class="font-display text-xl font-normal">{hub.data.name}</span>
          <span class="flex items-center gap-3"><span class="mono-tag rounded-full border border-dusk/60 px-2 py-0.5 text-dusk">{items.length}</span><Icon name="ph:caret-down-bold" class="size-5 text-dusk transition-transform duration-300 group-open:rotate-180" /></span>
        </summary>
        <ul class="grid gap-0.5 pb-3">
          <li><a href={`/${hub.id}/`} class="flex min-h-11 items-center font-medium text-dusk">View all {hub.data.name.toLowerCase()}</a></li>
          {items.map((s) => (
            <li><a href={`/${s.id}/`} class="flex min-h-11 items-center text-white/75">{s.data.name}</a></li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</div>

<style>
  /* Transparent at the top of a dark hero; solid night once scrolled (or always on paper pages). */
  [data-site-header][data-solid='true'] .rail-bar { background: rgb(11 19 43 / 0.94); backdrop-filter: blur(10px); }
  [data-site-header][data-solid='false'] .rail-bar { background: linear-gradient(to bottom, rgb(11 19 43 / 0.55), transparent); }
</style>

<script>
  // Turn the header solid after 80px of scroll, with an observer (no scroll listener).
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (header && sentinel && header.dataset.solid === 'false') {
    new IntersectionObserver(([e]) => { header.dataset.solid = String(!e.isIntersecting); }).observe(sentinel);
  }
  // Close the mobile menu after tapping a link inside it.
  const menu = document.getElementById('menu') as HTMLElement | null;
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.hidePopover();
  });
</script>
