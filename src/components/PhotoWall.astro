---
// "In photos": a wall of installation photos from across all four service groups, each linking to its service page.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/wall/*.webp', { eager: true });
const img = (name: string) => files[`../assets/images/wall/${name}.webp`].default;

// [file, caption, service page, alt text]
const tiles: [string, string, string, string][] = [
  ['invisible-grills-windows-apartment', 'Invisible grills for windows', '/invisible-grills-for-windows/', 'Apartment building with thin stainless steel invisible grills fitted over the windows'],
  ['balcony-safety-net-city-view', 'Balcony safety nets', '/balcony-safety-nets/', 'Clear safety net fitted across a high-rise balcony with a view of the city'],
  ['cricket-practice-net-pitch', 'Cricket practice nets', '/cricket-practice-nets/', 'Green cricket practice net enclosing a turf pitch'],
  ['anti-bird-net-balcony-plants', 'Anti bird nets', '/anti-bird-nets/', 'Anti bird net stretched along a balcony with potted plants'],
  ['invisible-grill-balcony-view', 'Invisible grills for balconies', '/invisible-grills-for-balconies/', 'Fine vertical stainless steel wires on a balcony with a wide green view'],
  ['construction-safety-net-building', 'Construction safety nets', '/construction-safety-nets/', 'Green safety net covering the scaffolding of a building under construction'],
  ['ceiling-cloth-hangers-balcony', 'Ceiling cloth hangers', '/ceiling-cloth-hangers/', 'Ceiling-mounted cloth hanger rods fitted in a balcony'],
  ['duct-area-safety-net-building', 'Duct area safety nets', '/duct-area-safety-nets/', 'Net closing a vertical duct between apartment blocks'],
  ['sports-ground-net', 'All sports nets', '/all-sports-nets/', 'Tall green net around a football ground'],
  ['safety-net-apartment-facade', 'Safety nets', '/safety-nets/', 'Safety net fitted across the face of an apartment building'],
  ['bird-spikes-close-up', 'Bird spikes', '/bird-spikes/', 'Close-up of stainless steel bird spikes fixed on a ledge'],
  ['invisible-grill-staircase', 'Invisible grills for staircases', '/invisible-grills/', 'Thin steel wires fitted between staircase railings'],
  ['balcony-safety-net-close', 'Balcony safety nets', '/balcony-safety-nets/', 'Safety net fitted along a balcony railing against the sky'],
  ['cricket-practice-net-lane', 'Cricket practice nets', '/cricket-practice-nets/', 'Blue cricket net lane with a green mat'],
  ['safety-net-building-exterior', 'Safety nets', '/safety-nets/', 'Safety net and frame fitted on the outside of a building'],
  ['duct-area-safety-net-apartment', 'Duct area safety nets', '/duct-area-safety-nets/', 'Apartment block with its duct area closed by a net'],
  ['balcony-safety-net-railing', 'Balcony safety nets', '/balcony-safety-nets/', 'Balcony net with a broad view over rooftops'],
];
---
<section id="photos" class="scroll-mt-24 bg-paper-2">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <p class="sec-tag text-ink-soft">03 / In photos</p>
    <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">Our work, <em class="em-brand">up close</em></h2>
    <p class="mt-5 max-w-[56ch] text-ink-soft">Nets, grills, hangers and spikes on real buildings across Hyderabad. Tap any photo to see that service.</p>
    <ul class="mt-12 columns-2 gap-4 md:columns-3 md:gap-6 lg:columns-4">
      {tiles.map(([file, caption, href, alt]) => (
        <li class="mb-4 break-inside-avoid md:mb-6">
          <a href={href} class="group block">
            <span class="crop-marks crop-marks-ink block">
              <span class="relative block overflow-hidden border border-ink/20 bg-night">
                <Picture src={img(file)} alt={alt} widths={[372, 500, 800]} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw" formats={['avif']} fallbackFormat="webp" class="h-auto w-full object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]" />
              </span>
            </span>
            <span class="mono-tag mt-3 block text-ink-soft transition-colors group-hover:text-dusk-text">{caption}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
