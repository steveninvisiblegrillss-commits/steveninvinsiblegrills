---
import { Picture } from 'astro:assets';
import { getCollection, getEntries } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props { service?: string; area?: string; limit?: number; heading?: string; filters?: boolean }
const { service, area, limit, heading = 'Recent work', filters = false } = Astro.props;
let projects = (await getCollection('projects')).sort((a, b) => +b.data.date - +a.data.date);
if (service) projects = projects.filter((p) => p.data.services.some((s) => s.id === service));
if (area) projects = projects.filter((p) => p.data.area.id === area);
if (limit) projects = projects.slice(0, limit);
const items = await Promise.all(projects.map(async (p) => ({ p, svc: await getEntries(p.data.services) })));
// Filter chips: one per service that actually has a project.
const chips = [...new Map(items.flatMap((i) => i.svc).map((s) => [s.id, s.data.name])).entries()];
---
{items.length > 0 && (
  <section class="py-14">
    {heading && <h2 class="text-3xl font-bold md:text-4xl">{heading}</h2>}
    {filters && chips.length > 1 && (
      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter projects by service" data-filters>
        <button type="button" data-filter="all" aria-pressed="true" class="min-h-11 rounded-full border border-brand px-4 text-sm font-semibold aria-pressed:bg-brand aria-pressed:text-white">All</button>
        {chips.map(([id, name]) => (
          <button type="button" data-filter={id} aria-pressed="false" class="min-h-11 rounded-full border border-line bg-card px-4 text-sm font-medium aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-white">{name}</button>
        ))}
      </div>
    )}
    <ul class="no-scrollbar -mx-4 mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3" data-project-list>
      {items.map(({ p, svc }) => (
        <li class="w-[82%] shrink-0 snap-center sm:w-auto" data-services={svc.map((s) => s.id).join(' ')}>
          <a href={`/projects/${p.id}/`} class="group block">
            <div class="overflow-hidden rounded-[var(--radius-card)]">
              <Picture src={p.data.photos[0].src} alt={p.data.photos[0].alt} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 82vw" formats={['avif']} fallbackFormat="webp" class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]" />
            </div>
            <p class="mt-3 flex items-start justify-between gap-3 font-medium group-hover:text-brand">
              <span>{p.data.title}</span>
              <Icon name="ph:arrow-up-right-bold" class="mt-1 size-4 shrink-0 text-brand" />
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
<script>
  // Project filter chips: show or hide tiles by service. Without JavaScript every project simply stays visible.
  document.querySelectorAll<HTMLElement>('[data-filters]').forEach((bar) => {
    const list = bar.parentElement!.querySelector<HTMLElement>('[data-project-list]')!;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const f = btn.dataset.filter!;
      list.querySelectorAll<HTMLElement>('li').forEach((li) => { li.hidden = f !== 'all' && !li.dataset.services!.split(' ').includes(f); });
    });
  });
</script>
