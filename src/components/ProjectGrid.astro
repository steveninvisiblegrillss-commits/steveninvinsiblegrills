---
// Recent jobs as crop-mark frames on paper. Filtered by service and/or area, newest first.
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props { service?: string; area?: string; limit?: number; heading?: string }
const { service, area, limit, heading = 'Recent work' } = Astro.props;
let projects = (await getCollection('projects')).sort((a, b) => +b.data.date - +a.data.date);
if (service) projects = projects.filter((p) => p.data.services.some((s) => s.id === service));
if (area) projects = projects.filter((p) => p.data.area.id === area);
if (limit) projects = projects.slice(0, limit);
---
{projects.length > 0 && (
  <section class="bg-paper-2">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
      <p class="sec-tag text-ink-soft">Recent work</p>
      {heading && <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">{heading}</h2>}
      <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`} class="group block">
              <span class="crop-marks crop-marks-ink block"><Picture src={p.data.photos[0].src} alt={p.data.photos[0].alt} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" formats={['avif']} fallbackFormat="webp" class="aspect-[4/5] w-full border border-ink/20 object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.03]" /></span>
              <span class="mt-4 block font-display text-xl leading-snug group-hover:text-dusk-text">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
