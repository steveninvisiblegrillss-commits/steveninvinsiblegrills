---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props { service?: string; area?: string; limit?: number; heading?: string }
const { service, area, limit, heading = 'Recent work' } = Astro.props;
let projects = (await getCollection('projects')).sort((a, b) => +b.data.date - +a.data.date);
if (service) projects = projects.filter((p) => p.data.services.some((s) => s.id === service));
if (area) projects = projects.filter((p) => p.data.area.id === area);
if (limit) projects = projects.slice(0, limit);
---
{projects.length > 0 && (
  <section class="py-14">
    <h2 class="text-3xl font-bold md:text-4xl">{heading}</h2>
    <ul class="no-scrollbar -mx-4 mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:block sm:columns-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 lg:columns-3">
      {projects.map((p) => (
        <li class="w-[82%] shrink-0 snap-center sm:mb-5 sm:w-auto sm:break-inside-avoid">
          <a href={`/projects/${p.id}/`} class="group block">
            <Picture src={p.data.photos[0].src} alt={p.data.photos[0].alt} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 82vw" formats={['avif']} fallbackFormat="webp" class="w-full rounded-[var(--radius-card)] object-cover" />
            <p class="mt-3 font-medium group-hover:text-brand">{p.data.title}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
