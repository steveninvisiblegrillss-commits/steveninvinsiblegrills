---
// "Chat Thread": each question is the customer's message on the right, each answer the reply on the left.
// Native <details>, so it is keyboard accessible with no JavaScript. The first one is open.
import { Icon } from 'astro-icon/components';
import { waLink, quoteMessage } from '../lib/whatsapp';

interface Props { faqs: { q: string; a: string }[]; heading?: string; tag?: string; service?: string }
const { faqs, heading = 'Questions people ask before they call', tag = '08 / Questions', service } = Astro.props;
const wa = waLink(quoteMessage({ service, path: Astro.url.pathname }));
---
{faqs.length > 0 && (
<section id="faq" class="scroll-mt-24 bg-night-2 text-white">
  <div class="mx-auto max-w-4xl px-4 py-20 md:px-8 md:py-28">
    <p class="sec-tag text-dusk">{tag}</p>
    <h2 class="mt-5 text-4xl md:text-6xl">{heading}</h2>
    <div class="mt-12 grid gap-5">
      {faqs.map((f, i) => (
        <details name="faq" open={i === 0} class="group">
          <summary class="ml-auto flex w-fit max-w-[92%] cursor-pointer list-none items-start gap-3 rounded-2xl rounded-br-sm border border-dusk/50 bg-dusk/10 px-5 py-3.5 text-left text-lg transition-colors hover:bg-dusk/20 md:max-w-[80%]">
            <span>{f.q}</span>
            <Icon name="ph:plus-light" class="mt-1 size-5 shrink-0 text-dusk group-open:hidden" />
            <Icon name="ph:minus-light" class="mt-1 hidden size-5 shrink-0 text-dusk group-open:block" />
          </summary>
          <p class="mt-3 max-w-[92%] rounded-2xl rounded-bl-sm bg-white/10 px-5 py-4 text-white/85 md:max-w-[75%]">{f.a}</p>
        </details>
      ))}
      <a href={wa} class="mt-4 flex w-fit max-w-[92%] items-center gap-3 rounded-2xl rounded-bl-sm bg-wa px-5 py-3.5 font-semibold text-white transition-transform hover:-translate-y-0.5">
        <Icon name="ph:whatsapp-logo-light" class="size-6" />Still unsure? Ask on WhatsApp
      </a>
    </div>
  </div>
</section>
)}
