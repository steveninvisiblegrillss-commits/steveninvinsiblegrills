---
// "The Net Board": a horizontal accordion of the four service groups. One panel is open at a time.
// Built on radio inputs, so it needs no JavaScript and works with the keyboard (arrow keys move between panels).
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const texture: Record<string, string> = {
  'safety-nets': 'repeating-linear-gradient(45deg, rgb(201 209 220 / 0.14) 0 1px, transparent 1px 14px), repeating-linear-gradient(-45deg, rgb(201 209 220 / 0.14) 0 1px, transparent 1px 14px)',
  'invisible-grills': 'repeating-linear-gradient(90deg, rgb(201 209 220 / 0.2) 0 1px, transparent 1px 22px)',
  'cloth-hangers': 'repeating-linear-gradient(0deg, rgb(201 209 220 / 0.2) 0 1px, transparent 1px 30px)',
  'sports-nets': 'repeating-linear-gradient(0deg, rgb(201 209 220 / 0.16) 0 1px, transparent 1px 26px), repeating-linear-gradient(90deg, rgb(201 209 220 / 0.16) 0 1px, transparent 1px 26px)',
};
const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const panels = all
  .filter((s) => s.data.kind === 'hub')
  .map((hub) => ({ hub, items: all.filter((s) => s.data.kind === 'service' && s.data.category === hub.data.category) }));
---
<section id="services" class="relative bg-night text-white">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <p class="sec-tag text-dusk">02 / Services</p>
    <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">Four ways we <em class="em-accent">protect</em> and improve your space</h2>
    <p class="mt-5 max-w-[60ch] text-white/65">Open a panel to see every service in that group. Each service page has pricing factors, FAQs and our recent work.</p>

    <fieldset class="mt-12 flex flex-col gap-px border border-steel/25 md:min-h-[36rem] md:flex-row">
      <legend class="sr-only">Service groups</legend>
      {panels.map(({ hub, items }, i) => (
        <label class="board-panel group/p relative flex cursor-pointer flex-col overflow-hidden bg-night-2 transition-[flex-grow] duration-700 ease-[var(--ease-out-quint)] md:grow md:basis-0 md:has-[:checked]:grow-[7]">
          <input type="radio" name="board" value={hub.id} checked={i === 0} class="peer sr-only" />
          <span class="pointer-events-none absolute inset-0" style={`background-image:${texture[hub.data.category]}`} aria-hidden="true"></span>

          {/* Collapsed header: a vertical title on desktop, a tap row on mobile. */}
          <span class="relative flex min-h-16 items-center justify-between gap-3 px-5 py-4 transition-colors group-hover/p:bg-white/5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:-outline-offset-4 peer-focus-visible:outline-dusk md:min-h-0 md:flex-1 md:flex-col md:items-start md:justify-between md:py-8 peer-checked:hidden">
            <span class="font-display text-3xl md:[writing-mode:vertical-rl] md:rotate-180 md:text-4xl">{hub.data.name}</span>
            <span class="mono-tag rounded-full border border-dusk/60 px-2.5 py-1 text-dusk md:[writing-mode:horizontal-tb]">{items.length} services</span>
          </span>

          {/* Opened content */}
          <span class="relative hidden flex-1 grid-cols-1 gap-6 p-5 peer-checked:grid md:grid-cols-[1.1fr_1fr] md:p-8">
            <span class="flex flex-col">
              <span class="mono-tag text-dusk">{items.length} services</span>
              <span class="mt-3 font-display text-4xl md:text-5xl">{hub.data.name}</span>
              <span class="mt-4 max-w-[44ch] text-white/70">{hub.data.description}</span>
              <span class="mt-5 flex flex-wrap gap-2">
                {items.map((s) => (
                  <a href={`/${s.id}/`} class="inline-flex min-h-11 items-center rounded-full border border-steel/35 px-4 text-sm font-medium text-white/90 transition-colors hover:border-dusk hover:text-dusk">{s.data.name}</a>
                ))}
              </span>
              <a href={`/${hub.id}/`} class="mt-auto inline-flex min-h-11 items-center gap-2 pt-6 font-semibold text-dusk">View all {hub.data.name.toLowerCase()} <Icon name="ph:arrow-right-light" class="size-5" /></a>
            </span>
            <span class="crop-marks relative hidden self-start md:block">
              <Picture src={hub.data.hero} alt={hub.data.heroAlt} widths={[480, 800]} sizes="(min-width: 768px) 30vw, 90vw" formats={['avif']} fallbackFormat="webp" class="aspect-[4/5] w-full object-cover" />
            </span>
          </span>
        </label>
      ))}
    </fieldset>
  </div>
</section>
