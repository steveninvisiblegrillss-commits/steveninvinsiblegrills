---
// "Contact Sheet": real installations laid out like a photographer's contact sheet, with frame numbers, a slight tilt that straightens on hover, and crop marks.
import { Picture, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

const tilt = [-1, 0.7, -0.5, 1, -0.8, 0.5, -0.3, 0.9];
const projects = (await getCollection('projects')).sort((a, b) => +b.data.date - +a.data.date);
const items = await Promise.all(
  projects.map(async (p) => {
    const photo = p.data.photos[0];
    const area = await getEntry(p.data.area);
    const full = await getImage({ src: photo.src, width: 1400, format: 'webp' });
    return { id: p.id, title: p.data.title, photo, area: area!.data.name, full: full.src };
  }),
);
---
{items.length > 0 && (
  <section id="gallery" class="scroll-mt-24 bg-night text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
      <p class="sec-tag text-dusk">06 / Proof</p>
      <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">Real installations by <em class="em-accent">our team</em></h2>
      <p class="mono-tag mt-5 text-white/50">Tap a frame to enlarge it</p>
      <ul class="no-scrollbar -mx-4 mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-8 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3">
        {items.map((it, i) => (
          <li class="w-[78%] shrink-0 snap-center sm:w-auto">
            <button type="button" data-lightbox data-full={it.full} data-alt={it.photo.alt} data-caption={it.title} class="frame group block w-full text-left" style={`--r:${tilt[i % tilt.length]}deg`}>
              <span class="crop-marks block border border-steel/45 bg-night-2 p-2">
                <span class="relative block overflow-hidden">
                  <Picture src={it.photo.src} alt={it.photo.alt} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 78vw" formats={['avif']} fallbackFormat="webp" class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]" />
                  <span class="mono-tag absolute left-2 top-2 bg-night/80 px-2 py-1 text-dusk">#{String(i + 1).padStart(2, '0')}</span>
                  <span class="absolute right-2 top-2 grid size-10 place-items-center bg-night/80 text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"><Icon name="ph:magnifying-glass-plus-duotone" class="size-5" /></span>
                </span>
              </span>
              <span class="mt-4 flex items-start justify-between gap-3">
                <span class="font-display text-xl leading-snug">{it.title}</span>
                <span class="mono-tag shrink-0 pt-1.5 text-white/55">{it.area}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <a href="/projects/" class="mt-12 inline-flex min-h-11 items-center gap-2 font-semibold text-dusk underline decoration-dusk/50 underline-offset-8">See all projects <Icon name="ph:arrow-right-light" class="size-5" /></a>
    </div>

    <dialog id="lightbox" class="m-auto max-h-[92dvh] w-[min(96vw,64rem)] overflow-hidden border border-steel/30 bg-night p-0 text-white" aria-label="Photo viewer">
      <form method="dialog" class="absolute right-3 top-3 z-10">
        <button class="grid size-11 place-items-center rounded-full border border-white/25 bg-night/80" aria-label="Close photo"><Icon name="ph:x-bold" class="size-5" /></button>
      </form>
      <img id="lightbox-img" alt="Enlarged project photo" width="1400" height="1050" class="max-h-[78dvh] w-full object-contain" />
      <p id="lightbox-caption" class="mono-tag p-4 text-white/75"></p>
    </dialog>
  </section>
)}

<style>
  /* Each frame sits at a slight angle, like prints on a table, and straightens when you point at it. */
  @media (min-width: 640px) {
    .frame { transform: rotate(var(--r)); transition: transform 500ms var(--ease-out-quint); }
    .frame:hover, .frame:focus-visible { transform: rotate(0deg) translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) { .frame { transform: none !important; } }
</style>

<script>
  // Lightbox on the native <dialog>: focus trap, Esc to close and backdrop are built in.
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const cap = document.getElementById('lightbox-caption')!;
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => {
        img.src = b.dataset.full!;
        img.alt = b.dataset.alt!;
        cap.textContent = b.dataset.caption!;
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
