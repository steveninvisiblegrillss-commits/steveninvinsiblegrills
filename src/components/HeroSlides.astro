---
// Photo hero: full-screen photos that slide across on their own (swipe works too), with the headline and quote buttons on top.
// It owns the page's H1.
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';
import sunset from '../assets/images/services/golden-balcony-sunset-net.webp';
import balcony from '../assets/images/hero/modern-balcony-grill-city-view.webp';
import cat from '../assets/images/services/tabby-cat-balcony-net.webp';
import windows from '../assets/images/wall/invisible-grills-windows-apartment.webp';
import hangers from '../assets/images/services/balcony-cloth-hangers-hyderabad.webp';

const wa = waLink(quoteMessage({ path: '/' }));
const slides = [
  { img: sunset, alt: 'Clear safety net fitted across a balcony at sunset with a view over the city' },
  { img: balcony, alt: 'Sunlit apartment balcony with an invisible grill of thin stainless steel wires and a clear view of the city' },
  { img: cat, alt: 'Tabby cat sitting behind a safety net on a sunny balcony' },
  { img: windows, alt: 'Apartment building with thin stainless steel invisible grills over the windows' },
  { img: hangers, alt: 'Cloth hanger frame on a balcony railing holding folded clothes' },
];
// The first photo is repeated at the end so the last slide slides on to the first without a jump backwards.
const track = [...slides, { ...slides[0], clone: true }];
const trust = [['10+', 'years'], ['Free', 'installation'], ['Free', 'site visit']];
---
<section class="reel relative isolate flex min-h-[100dvh] flex-col overflow-hidden bg-night text-white" data-reel>
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    <div class="track flex h-full" data-track style={`width:${track.length * 100}%`}>
      {track.map((s, i) => (
        <div class="h-full flex-none" style={`width:${100 / track.length}%`}>
          <Picture src={s.img} alt={s.alt} widths={[640, 1100, 1672]} sizes="100vw" formats={['avif']} fallbackFormat="webp" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class="size-full object-cover" />
        </div>
      ))}
    </div>
  </div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(11_19_43/0.88)_0%,rgb(11_19_43/0.55)_45%,rgb(11_19_43/0.1)_100%)] md:bg-[linear-gradient(90deg,rgb(11_19_43/0.85)_0%,rgb(11_19_43/0.4)_50%,transparent_100%)]" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-night/80 to-transparent" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-28 pt-28 md:px-8 md:pb-16 md:pt-24">
    <div class="max-w-2xl">
      <h1 class="rise text-[3.1rem] leading-[0.95] sm:text-6xl lg:text-7xl" style="--i:0">Invisible grills and safety nets for <em class="em-accent">Hyderabad homes</em></h1>
      <p class="mt-6 max-w-[48ch] text-lg text-white/85 md:text-xl">Protect balconies, children and pets without blocking the view. Professional installation, and installation is free.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={wa} data-service="" class="btn-tail group inline-flex min-h-12 items-center gap-3 rounded-full bg-dusk py-2 pl-6 pr-2 font-semibold text-night transition-transform active:scale-[0.98]">Get a free quote <span class="grid size-8 place-items-center rounded-full bg-black/10"><Icon name="ph:arrow-up-right-bold" class="size-4" /></span></a>
        <a href={telLink()} class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/30 bg-night/40 px-6 font-semibold backdrop-blur-md transition-colors hover:bg-white/15"><Icon name="ph:phone-duotone" class="size-5" />Call {site.phoneDisplay.replace('+91 ', '')}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-2">
        {trust.map(([big, small]) => <li class="flex items-baseline gap-2"><span class="font-display text-3xl text-dusk">{big}</span><span class="mono-tag text-white/70">{small}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .track { transition: transform 550ms cubic-bezier(0.65, 0, 0.35, 1); will-change: transform; }
  .track.snap { transition: none; }
  @media (prefers-reduced-motion: reduce) { .track { transition: none; } }
</style>

<script>
  // Slides on its own every 2.6 seconds. Pauses while the page is hidden or the mouse is over the hero. Swipe on touch screens.
  const root = document.querySelector<HTMLElement>('[data-reel]');
  const track = root?.querySelector<HTMLElement>('[data-track]');
  if (root && track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const n = track.children.length - 1; // the last child is the repeat of the first
    const EVERY = 2600;
    let i = 0, timer: number | undefined, hold = false;
    const set = (k: number, animate = true) => {
      track.classList.toggle('snap', !animate);
      track.style.transform = `translateX(-${(k * 100) / (n + 1)}%)`;
      if (!animate) void track.offsetWidth;
    };
    const next = () => {
      i += 1;
      set(i);
      if (i === n) setTimeout(() => { i = 0; set(0, false); }, 600); // after sliding on to the repeat, snap back to the real first photo
    };
    const prev = () => {
      if (i === 0) { i = n; set(n, false); }
      i -= 1;
      requestAnimationFrame(() => set(i));
    };
    const loop = () => { clearInterval(timer); if (!hold && !document.hidden) timer = window.setInterval(next, EVERY); };
    root.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { hold = true; loop(); } });
    root.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { hold = false; loop(); } });
    document.addEventListener('visibilitychange', loop);
    let x0 = 0;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) { dx < 0 ? next() : prev(); loop(); }
    }, { passive: true });
    loop();
  }
</script>
