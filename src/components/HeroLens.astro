---
// "There's a grill in this photo. Can you see it?"
// The hero is the product demo: faint steel cables over a clean balcony photo, lit only under the cursor
// (or by an idle sweep on touch screens).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';

interface Props { image: ImageMetadata; imageAlt: string }
const { image, imageAlt } = Astro.props;
const wa = waLink(quoteMessage({ path: '/' }));
const proof = [
  { icon: 'ph:shield-check-duotone', text: 'Corrosion-resistant stainless steel' },
  site.freeInstallation && { icon: 'ph:ruler-duotone', text: 'Free site visit and measurement' },
  { icon: 'ph:squares-four-duotone', text: 'Balconies, windows and ducts' },
].filter(Boolean) as { icon: string; text: string }[];
---
<section class="lens-hero relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-brand-deep text-white" data-lens-hero data-tracking="false" data-reveal="false">
  <Picture src={image} alt={imageAlt} widths={[640, 1024, 1600, 2000]} sizes="100vw" formats={['avif']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="absolute inset-0 -z-30 size-full object-cover object-[70%_center]" />
  <div class="ov-x pointer-events-none absolute inset-0 -z-20"></div>
  <div class="ov-y pointer-events-none absolute inset-x-0 bottom-0 -z-20 h-2/5"></div>

  <div class="cables cables-faint pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="cables cables-lens pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="cables cables-full pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="lens-ring pointer-events-none absolute z-0" aria-hidden="true">
    <span class="lens-label">Stainless steel cable</span>
  </div>

  <button type="button" data-lens-toggle aria-pressed="false" class="absolute right-4 top-24 z-10 inline-flex min-h-11 items-center gap-2 rounded-full border border-white/20 bg-brand-deep/70 px-4 text-sm font-medium backdrop-blur-md transition-colors hover:bg-brand-deep md:bottom-24 md:right-8 md:top-auto">
    <Icon name="ph:eye-duotone" class="size-5 text-accent" data-on />
    <Icon name="ph:eye-slash-duotone" class="hidden size-5 text-accent" data-off />
    <span data-label>Show the grill</span>
  </button>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-6 pt-28 md:px-8">
    <div class="max-w-xl">
      <p class="rise inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.14em] backdrop-blur-sm" style="--i:0">
        <span class="size-1.5 rounded-full bg-accent"></span>Invisible grills and safety nets, Hyderabad
      </p>
      <h1 class="rise mt-5 text-[3rem] leading-[0.95] sm:text-6xl lg:text-7xl" style="--i:1">
        There's a grill in this photo. <em class="em-accent">Can you see it?</em>
      </h1>
      <p class="rise mt-5 max-w-md text-base text-white/75 sm:text-lg" style="--i:2">Slim stainless steel wires and safety nets that keep kids, pets and pigeons safe on Hyderabad balconies and windows, without taking away your view.</p>
      <p class="rise mt-4 flex items-center gap-2 text-sm text-white/60" style="--i:3">
        <Icon name="ph:cursor-click-duotone" class="hidden size-5 shrink-0 text-accent [@media(hover:hover)]:block" />
        <Icon name="ph:hand-pointing-duotone" class="size-5 shrink-0 text-accent [@media(hover:hover)]:hidden" />
        <span class="hidden [@media(hover:hover)]:inline">Move your cursor across the view to find the cables.</span>
        <span class="[@media(hover:hover)]:hidden">Tap "Show the grill" to find the cables.</span>
      </p>
      <div class="rise mt-7 grid gap-3 sm:flex" style="--i:4">
        <a href={wa} class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-7 font-semibold text-accent-ink transition-transform duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Book a free site visit</a>
        <a href={telLink()} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/25 px-7 font-semibold transition-colors hover:bg-white/10"><Icon name="ph:phone-duotone" class="size-5" />Call {site.phoneDisplay.replace('+91 ', '')}</a>
      </div>
    </div>
  </div>

  <ul class="relative z-10 mx-auto grid w-full max-w-7xl gap-2 px-4 pb-28 text-sm text-white/70 sm:flex sm:flex-wrap sm:gap-x-8 md:px-8 md:pb-8">
    {proof.map((p) => (
      <li class="flex items-center gap-2"><Icon name={p.icon} class="size-5 shrink-0 text-accent" />{p.text}</li>
    ))}
  </ul>
</section>

<style>
  .lens-hero { --lens-size: 90px; --x: 62%; --y: 45%; }
  @media (hover: none) { .lens-hero { --lens-size: 70px; } }

  /* Readability: navy from the left, and a fade at the bottom. */
  .ov-x { background: linear-gradient(90deg, #0b1426 0%, rgb(11 20 38 / 0.75) 45%, transparent 100%); }
  @media (min-width: 768px) { .ov-x { background: linear-gradient(90deg, #0b1426 0%, rgb(11 20 38 / 0.55) 45%, transparent 100%); } }
  .ov-y { background: linear-gradient(to top, #0b1426, transparent); }

  /* The grill drawn in CSS: a wire every 30px with a bright highlight and darker edges. */
  .cables {
    background-image: repeating-linear-gradient(90deg,
      transparent 0, transparent 12px,
      rgb(150 165 185 / 0.7) 12px, rgb(150 165 185 / 0.7) 13px,
      rgb(236 243 250 / 0.95) 13px, rgb(236 243 250 / 0.95) 15px,
      rgb(150 165 185 / 0.7) 15px, rgb(150 165 185 / 0.7) 16px,
      transparent 16px, transparent 30px);
  }
  /* Always there, almost invisible, and never behind the text. */
  .cables-faint { opacity: 0.06; mask-image: linear-gradient(90deg, transparent 45%, #000 70%); }
  /* Lit only inside a circle around the cursor (or the idle sweep). */
  .cables-lens {
    filter: drop-shadow(0 0 2px rgb(245 184 61 / 0.55));
    mask-image: radial-gradient(circle var(--lens-size) at var(--x) var(--y), #000 30%, transparent 100%);
    transition: opacity 300ms ease;
  }
  /* Full reveal for the toggle. The text side stays clean. */
  .cables-full {
    opacity: 0.85;
    mask-image: linear-gradient(90deg, transparent 28%, #000 58%), radial-gradient(circle var(--reveal-r) at var(--rx, 90%) var(--ry, 90%), #000 98%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    transition: --reveal-r 1000ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal='true'] { --reveal-r: 170vmax; }
  [data-reveal='true'] .cables-lens,
  [data-reveal='true'] .lens-ring { opacity: 0; }

  /* Ring and label follow a real pointer. Hidden on touch. */
  .lens-ring {
    display: none;
    left: var(--x); top: var(--y);
    width: calc(var(--lens-size) * 2.3); height: calc(var(--lens-size) * 2.3);
    translate: -50% -50%;
    border: 1px solid rgb(245 184 61 / 0.35); border-radius: 9999px;
    opacity: 0; transition: opacity 300ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .lens-ring { display: block; } }
  [data-tracking='true'] .lens-ring { opacity: 1; }
  .lens-label {
    position: absolute; left: 100%; top: 50%; translate: 10px -50%;
    white-space: nowrap; border-radius: 9999px; padding: 4px 10px;
    font-size: 12px; color: #f5b83d;
    background: rgb(11 20 38 / 0.75); backdrop-filter: blur(8px);
  }

  /* Idle sweep: shows people where to look until they move the cursor. Off for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    [data-tracking='false'] { animation: lens-sweep 7s ease-in-out infinite alternate; }
  }
  @keyframes lens-sweep {
    from { --x: 55%; --y: 30%; }
    to { --x: 92%; --y: 55%; }
  }
  [data-tracking='true'] { animation: none; }

  :global(.lens-hero button:focus-visible), :global(.lens-hero a:focus-visible) { outline: 3px solid #f5b83d; outline-offset: 3px; }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-lens-hero]');
  if (hero) {
    // Spring-like follow: the lens eases toward the pointer instead of snapping to it.
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, active = false;
    const read = (name: string) => parseFloat(getComputedStyle(hero).getPropertyValue(name)) || 0;
    const tick = () => {
      cx += (tx - cx) * 0.16;
      cy += (ty - cy) * 0.16;
      hero.style.setProperty('--x', cx + '%');
      hero.style.setProperty('--y', cy + '%');
      raf = active || Math.hypot(tx - cx, ty - cy) > 0.05 ? requestAnimationFrame(tick) : 0;
    };
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || hero.dataset.reveal === 'true') return;
      const r = hero.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width) * 100;
      ty = ((e.clientY - r.top) / r.height) * 100;
      if (hero.dataset.tracking !== 'true') { cx = read('--x'); cy = read('--y'); hero.dataset.tracking = 'true'; }
      active = true;
      if (!raf) raf = requestAnimationFrame(tick);
    });
    hero.addEventListener('pointerleave', () => {
      active = false;
      hero.dataset.tracking = 'false';
      hero.style.removeProperty('--x');
      hero.style.removeProperty('--y');
    });

    const btn = hero.querySelector<HTMLButtonElement>('[data-lens-toggle]')!;
    btn.addEventListener('click', () => {
      const on = hero.dataset.reveal !== 'true';
      if (on) {
        // The reveal grows as a circle out of the button.
        const r = hero.getBoundingClientRect(), b = btn.getBoundingClientRect();
        hero.style.setProperty('--rx', ((b.left + b.width / 2 - r.left) / r.width) * 100 + '%');
        hero.style.setProperty('--ry', ((b.top + b.height / 2 - r.top) / r.height) * 100 + '%');
      }
      hero.dataset.reveal = String(on);
      btn.setAttribute('aria-pressed', String(on));
      btn.querySelector('[data-label]')!.textContent = on ? 'Hide the grill' : 'Show the grill';
      btn.querySelector('[data-on]')!.classList.toggle('hidden', on);
      btn.querySelector('[data-off]')!.classList.toggle('hidden', !on);
    });
  }
</script>
