---
// "There's a grill in this photo. Can you see it?"
// A cinematic hero: faint steel cables over a clean balcony photo, lit by a soft lens that glides behind the pointer
// on spring physics. A glass dock reveals the full grill with a dramatic expanding circle.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';

interface Props { image: ImageMetadata; imageAlt: string }
const { image, imageAlt } = Astro.props;
const wa = waLink(quoteMessage({ path: '/' }));
// Confirmed claims only. "Marine-grade" is left out until the owner confirms the steel grade.
const proof = [
  { icon: 'ph:shield-check-duotone', text: 'Corrosion-resistant stainless steel' },
  site.freeInstallation && { icon: 'ph:ruler-duotone', text: 'Free site visit and measurement' },
  { icon: 'ph:squares-four-duotone', text: 'Balconies, windows and ducts' },
].filter(Boolean) as { icon: string; text: string }[];
const dock = ['Stainless steel cables', 'Free measurement', 'Balconies and windows'];
---
<section class="lens-hero relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-brand-deep text-white" data-lens-hero data-tracking="false" data-reveal="false">
  <Picture src={image} alt={imageAlt} widths={[640, 1024, 1600, 2000]} sizes="100vw" formats={['avif']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="hero-breathe absolute inset-0 -z-30 size-full object-cover object-[70%_center]" />
  <div class="ov-x pointer-events-none absolute inset-0 -z-20"></div>
  <div class="ov-y pointer-events-none absolute inset-x-0 bottom-0 -z-20 h-2/5"></div>

  <div class="cables cables-faint pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="cables cables-lens pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="cables cables-full pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="lens-ring pointer-events-none absolute z-0" aria-hidden="true"><span class="lens-label">Stainless steel cable</span></div>
  <div class="cursor-dot pointer-events-none absolute left-0 top-0 z-30" aria-hidden="true"></div>

  <button type="button" data-lens-toggle="mobile" aria-pressed="false" class="absolute right-4 top-24 z-10 inline-flex min-h-11 items-center gap-2 rounded-full border border-white/20 bg-brand-deep/70 px-4 text-sm font-medium backdrop-blur-md md:hidden">
    <Icon name="ph:eye-duotone" class="size-5 text-accent" data-on />
    <Icon name="ph:eye-slash-duotone" class="hidden size-5 text-accent" data-off />
    <span data-label>Show the grill</span>
  </button>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-6 pt-28 md:px-8">
    <div class="max-w-xl">
      <p class="rise inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.14em] backdrop-blur-sm" style="--i:0">
        <span class="size-1.5 rounded-full bg-accent"></span>Invisible grills and safety nets, Hyderabad
      </p>
      <h1 class="rise mt-5 text-[3rem] leading-[0.95] sm:text-6xl lg:text-7xl" style="--i:1" data-cursor-grow>
        There's a grill in this photo. <em class="em-accent glow">Can you see it?</em>
      </h1>
      <p class="rise mt-5 max-w-md text-base tracking-wide text-white/75 sm:text-lg" style="--i:2">Slim stainless steel wires and safety nets that keep kids, pets and pigeons safe on Hyderabad balconies and windows, without taking away your view.</p>
      <p class="rise mt-4 flex items-center gap-2 text-sm text-white/60" style="--i:3">
        <Icon name="ph:cursor-click-duotone" class="hidden size-5 shrink-0 text-accent [@media(hover:hover)]:block" />
        <Icon name="ph:hand-pointing-duotone" class="size-5 shrink-0 text-accent [@media(hover:hover)]:hidden" />
        <span class="hidden [@media(hover:hover)]:inline">Move your cursor across the view to find the cables.</span>
        <span class="[@media(hover:hover)]:hidden">Tap "Show the grill" to find the cables.</span>
      </p>
      <div class="rise mt-7 grid gap-3 sm:flex" style="--i:4">
        <a href={wa} data-magnetic class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-7 font-semibold text-accent-ink transition-[filter] duration-300 hover:brightness-110">Book a free site visit</a>
        <a href={telLink()} data-magnetic class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 font-semibold backdrop-blur-md transition-colors hover:bg-white/10"><Icon name="ph:phone-duotone" class="size-5" />Call {site.phoneDisplay.replace('+91 ', '')}</a>
      </div>
    </div>
  </div>

  <ul class="relative z-10 mx-auto grid w-full max-w-7xl gap-2 px-4 pb-28 text-sm text-white/70 md:hidden">
    {proof.map((p) => (
      <li class="flex items-center gap-2"><Icon name={p.icon} class="size-5 shrink-0 text-accent" />{p.text}</li>
    ))}
  </ul>

  {/* Floating glass dock (tablet and desktop): features on the left, a real switch on the right. */}
  <div class="pointer-events-none absolute inset-x-0 bottom-6 z-20 hidden justify-center px-4 md:flex">
    <div class="pointer-events-auto flex items-center gap-5 rounded-full border border-white/10 bg-brand-deep/60 px-6 py-3 text-sm text-white/80 backdrop-blur-md">
      <ul class="flex items-center gap-4">
        {dock.map((d, i) => (
          <li class="flex items-center gap-4">
            {i > 0 && <span class="size-1 rounded-full bg-accent shadow-[0_0_8px_#f5b83d]" aria-hidden="true"></span>}
            <span>{d}</span>
          </li>
        ))}
      </ul>
      <span class="h-5 w-px bg-white/15" aria-hidden="true"></span>
      <button type="button" role="switch" aria-checked="false" data-lens-toggle="dock" class="group flex min-h-11 items-center gap-3 rounded-full pl-1 pr-2 font-medium text-white">
        <span data-label>Reveal full view</span>
        <span class="relative h-6 w-11 rounded-full border border-white/20 bg-white/10 transition-colors duration-500 group-aria-checked:bg-accent">
          <span class="absolute left-0.5 top-0.5 size-5 rounded-full bg-white transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-aria-checked:translate-x-5"></span>
        </span>
      </button>
    </div>
  </div>
</section>

<style>
  .lens-hero {
    --lens-size: 130px; --x: 62%; --y: 45%;
    /* One gold accent wire every 300px, the gold wire from the logo. */
    --gold-wire: repeating-linear-gradient(90deg, transparent 0, transparent 148px, rgb(245 184 61 / 0.95) 148px, rgb(245 184 61 / 0.95) 151px, transparent 151px, transparent 300px);
  }
  @media (hover: none) { .lens-hero { --lens-size: 80px; } }

  /* Slow cinematic breathing on the photo. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-breathe { animation: breathe 20s ease-in-out infinite alternate; }
  }
  @keyframes breathe { from { transform: scale(1); } to { transform: scale(1.05); } }

  /* Readability: navy from the left, and a fade at the bottom. */
  .ov-x { background: linear-gradient(90deg, #0b1426 0%, rgb(11 20 38 / 0.75) 45%, transparent 100%); }
  @media (min-width: 768px) { .ov-x { background: linear-gradient(90deg, #0b1426 0%, rgb(11 20 38 / 0.55) 45%, transparent 100%); } }
  .ov-y { background: linear-gradient(to top, #0b1426, transparent); }

  /* The grill drawn in CSS: a wire every 30px with a bright highlight and darker steel edges. */
  .cables {
    background-image: var(--gold-wire), repeating-linear-gradient(90deg,
      transparent 0, transparent 12px,
      rgb(150 165 185 / 0.7) 12px, rgb(150 165 185 / 0.7) 13px,
      rgb(236 243 250 / 0.95) 13px, rgb(236 243 250 / 0.95) 15px,
      rgb(150 165 185 / 0.7) 15px, rgb(150 165 185 / 0.7) 16px,
      transparent 16px, transparent 30px);
  }
  .cables { will-change: transform; }
  .cables-faint { opacity: 0.06; mask-image: linear-gradient(90deg, transparent 45%, #000 70%); }
  /* A soft, feathered lens instead of a hard circle. */
  .cables-lens {
    background-image: var(--gold-wire), repeating-linear-gradient(90deg,
      transparent 0, transparent 11px,
      rgb(245 184 61 / 0.5) 11px, rgb(245 184 61 / 0.5) 12px,
      rgb(150 165 185 / 0.7) 12px, rgb(150 165 185 / 0.7) 13px,
      rgb(236 243 250 / 0.95) 13px, rgb(236 243 250 / 0.95) 15px,
      rgb(150 165 185 / 0.7) 15px, rgb(150 165 185 / 0.7) 16px,
      rgb(245 184 61 / 0.5) 16px, rgb(245 184 61 / 0.5) 17px,
      transparent 17px, transparent 30px);
    mask-image: radial-gradient(circle var(--lens-size) at var(--x) var(--y), #000 0%, rgb(0 0 0 / 0.8) 30%, rgb(0 0 0 / 0.3) 65%, transparent 100%);
  }
  /* The climax: a circle that grows out of the switch to cover the whole screen (text side kept clean). */
  .cables-full {
    opacity: 0.85;
    mask-image: linear-gradient(90deg, transparent 28%, #000 58%), radial-gradient(circle var(--reveal-r) at var(--rx, 90%) var(--ry, 90%), #000 98%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    transition: --reveal-r 1500ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  [data-reveal='true'] { --reveal-r: 300vw; }
  [data-reveal='true'] .cables-lens,
  [data-reveal='true'] .lens-ring { opacity: 0; transition: opacity 400ms ease; }

  .lens-ring {
    display: none;
    left: var(--x); top: var(--y);
    width: calc(var(--lens-size) * 2.3); height: calc(var(--lens-size) * 2.3);
    translate: -50% -50%;
    border: 1px solid rgb(245 184 61 / 0.3); border-radius: 9999px;
    opacity: 0; transition: opacity 300ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .lens-ring { display: block; } }
  [data-tracking='true'] .lens-ring { opacity: 1; }
  .lens-label {
    position: absolute; left: 100%; top: 50%; translate: 10px -50%;
    white-space: nowrap; border-radius: 9999px; padding: 4px 10px;
    font-size: 12px; color: #f5b83d;
    background: rgb(11 20 38 / 0.75); backdrop-filter: blur(8px);
  }

  /* Idle sweep until the visitor moves a mouse; always on for touch. Off for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    [data-tracking='false'] { animation: lens-sweep 7s ease-in-out infinite alternate; }
  }
  @keyframes lens-sweep { from { --x: 55%; --y: 30%; } to { --x: 92%; --y: 55%; } }
  [data-tracking='true'] { animation: none; }
  [data-offscreen='true'] { animation-play-state: paused !important; }

  /* Reduced motion: no lens, no ring, no breathing, no instant-vs-animated surprises. Only the faint layer stays; the switch still reveals. */
  @media (prefers-reduced-motion: reduce) {
    .cables-lens, .lens-ring { display: none; }
    .hero-breathe { animation: none; }
    .cables-full { transition: none; }
  }

  /* Slower, more cinematic entrance for this hero only. */
  :global(.lens-hero .rise) { animation-duration: 1.5s; animation-delay: calc(var(--i, 0) * 170ms + 250ms); }
  .glow { text-shadow: 0 0 32px rgb(245 184 61 / 0.4); }

  /* Custom cursor: a white dot that grows into an inverted circle over buttons and the headline. Mouse only. */
  .cursor-dot { display: none; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 9999px; background: #fff; mix-blend-mode: difference; opacity: 0; transition: width 250ms ease, height 250ms ease, margin 250ms ease, opacity 200ms ease; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cursor-dot { display: block; }
    .lens-hero { cursor: none; }
    .lens-hero a, .lens-hero button { cursor: pointer; }
    [data-tracking='true'] .cursor-dot { opacity: 1; }
    .cursor-dot[data-grow='true'] { width: 64px; height: 64px; margin: -32px 0 0 -32px; }
  }

  :global(.lens-hero button:focus-visible), :global(.lens-hero a:focus-visible) { outline: 3px solid #f5b83d; outline-offset: 3px; }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-lens-hero]');
  if (hero) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dot = hero.querySelector<HTMLElement>('.cursor-dot')!;
    const read = (name: string) => parseFloat(getComputedStyle(hero).getPropertyValue(name)) || 0;

    // Spring physics (stiffness 50, damping 20, mass 0.5): the lens glides behind the pointer with weight.
    const K = 50, C = 20, M = 0.5;
    let tx = 0, ty = 0, x = 0, y = 0, vx = 0, vy = 0, last = 0, raf = 0;
    let px = 0, py = 0; // raw pointer in px, for the dot and the magnetic buttons
    const step = (t: number) => {
      const dt = Math.min((t - (last || t)) / 1000, 1 / 30);
      last = t;
      vx += ((-K * (x - tx) - C * vx) / M) * dt;
      vy += ((-K * (y - ty) - C * vy) / M) * dt;
      x += vx * dt; y += vy * dt;
      hero.style.setProperty('--x', x + '%');
      hero.style.setProperty('--y', y + '%');
      const settled = Math.abs(x - tx) + Math.abs(y - ty) + Math.abs(vx) + Math.abs(vy) < 0.02;
      if (settled && hero.dataset.tracking !== 'true') { raf = 0; last = 0; return; }
      raf = requestAnimationFrame(step);
    };

    // Magnetic buttons: pulled slightly toward the pointer when it is close.
    const magnets = [...hero.querySelectorAll<HTMLElement>('[data-magnetic]')];
    const pull = () => {
      for (const m of magnets) {
        const r = m.getBoundingClientRect();
        const dx = px - (r.left + r.width / 2), dy = py - (r.top + r.height / 2);
        const near = Math.hypot(dx, dy) < Math.max(r.width, r.height) * 0.9;
        m.style.transform = near && !calm ? `translate(${Math.max(-10, Math.min(10, dx * 0.22))}px, ${Math.max(-8, Math.min(8, dy * 0.3))}px)` : '';
        m.style.transition = 'transform 400ms cubic-bezier(0.22, 1, 0.36, 1)';
      }
    };

    hero.addEventListener('pointermove', (e) => {
      if (calm || e.pointerType === 'touch') return;
      const r = hero.getBoundingClientRect();
      px = e.clientX; py = e.clientY;
      if (hero.dataset.reveal !== 'true') {
        tx = ((e.clientX - r.left) / r.width) * 100;
        ty = ((e.clientY - r.top) / r.height) * 100;
        if (hero.dataset.tracking !== 'true') { x = read('--x'); y = read('--y'); vx = vy = 0; hero.dataset.tracking = 'true'; }
        if (!raf) raf = requestAnimationFrame(step);
      }
      if (fine) {
        dot.style.transform = `translate(${e.clientX - r.left}px, ${e.clientY - r.top}px)`;
        const hot = (e.target as HTMLElement).closest('a, button, [data-cursor-grow]');
        dot.dataset.grow = String(Boolean(hot));
      }
      pull();
    });
    hero.addEventListener('pointerleave', () => {
      hero.dataset.tracking = 'false';
      hero.style.removeProperty('--x');
      hero.style.removeProperty('--y');
      px = py = -9999;
      pull();
    });

    // Save battery: pause the idle sweep when the hero is scrolled out of view.
    new IntersectionObserver(([e]) => { hero.dataset.offscreen = String(!e.isIntersecting); }).observe(hero);

    // Both switches (mobile button and desktop dock) share one state.
    const toggles = [...hero.querySelectorAll<HTMLButtonElement>('[data-lens-toggle]')];
    const apply = (on: boolean, origin?: HTMLElement) => {
      if (on && origin) {
        const r = hero.getBoundingClientRect(), b = origin.getBoundingClientRect();
        hero.style.setProperty('--rx', ((b.left + b.width / 2 - r.left) / r.width) * 100 + '%');
        hero.style.setProperty('--ry', ((b.top + b.height / 2 - r.top) / r.height) * 100 + '%');
      }
      hero.dataset.reveal = String(on);
      for (const t of toggles) {
        t.setAttribute(t.getAttribute('role') === 'switch' ? 'aria-checked' : 'aria-pressed', String(on));
        const label = t.querySelector('[data-label]');
        if (label) label.textContent = t.dataset.lensToggle === 'dock' ? (on ? 'Hide full view' : 'Reveal full view') : on ? 'Hide the grill' : 'Show the grill';
        t.querySelector('[data-on]')?.classList.toggle('hidden', on);
        t.querySelector('[data-off]')?.classList.toggle('hidden', !on);
      }
    };
    toggles.forEach((t) => t.addEventListener('click', () => apply(hero.dataset.reveal !== 'true', t)));
  }
</script>
