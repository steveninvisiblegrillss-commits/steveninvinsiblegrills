---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const icons: Record<string, string> = {
  'safety-nets': 'ph:shield-check-duotone',
  'invisible-grills': 'ph:squares-four-duotone',
  'cloth-hangers': 'ph:t-shirt-duotone',
  'sports-nets': 'ph:cricket-duotone',
};
const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const pillars = all
  .filter((s) => s.data.kind === 'hub')
  .map((hub) => ({ hub, items: all.filter((s) => s.data.kind === 'service' && s.data.category === hub.data.category) }));
---
<section id="services" class="scroll-mt-24 bg-surface-2">
  <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-28">
    <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Four ways we protect and improve your space</h2>
    <p class="mt-3 max-w-[60ch] text-ink-soft">Tap a group to see every service we install. Each service page has pricing factors, FAQs and our recent work.</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {pillars.map(({ hub, items }) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-brand-deep text-white shadow-[var(--shadow-soft)]">
          <a href={`/${hub.id}/`} class="group relative block" aria-label={`${hub.data.name}: view all`}>
            <Picture src={hub.data.hero} alt={hub.data.heroAlt} widths={[480, 800, 1000]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif']} fallbackFormat="webp" class="aspect-[16/9] w-full object-cover opacity-90 transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-deep via-brand-deep/30 to-transparent"></div>
            <span class="absolute left-5 top-5 grid size-12 place-items-center rounded-xl border border-white/15 bg-white/10 backdrop-blur-md">
              <Icon name={icons[hub.data.category]} class="size-7 text-accent" />
            </span>
          </a>
          <div class="flex flex-1 flex-col p-6 pt-4">
            <h3 class="text-2xl font-bold"><a href={`/${hub.id}/`} class="inline-flex min-h-11 items-center hover:underline">{hub.data.name}</a></h3>
            <p class="mb-5 mt-2 text-white/75">{hub.data.description}</p>
            <details name="pillar" class="group/d mt-auto border-t border-white/10 pt-4">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 font-semibold">
                <span>{items.length} services</span>
                <Icon name="ph:caret-down-bold" class="size-5 text-accent transition-transform duration-300 group-open/d:rotate-180" />
              </summary>
              <ul class="mt-3 flex flex-wrap gap-2">
                {items.map((s) => (
                  <li><a href={`/${s.id}/`} class="inline-block min-h-11 rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium transition-colors hover:bg-white/15">{s.data.name}</a></li>
                ))}
              </ul>
              <a href={`/${hub.id}/`} class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent">View all {hub.data.name.toLowerCase()}<Icon name="ph:arrow-right-bold" class="size-4" /></a>
            </details>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
