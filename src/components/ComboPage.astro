---
import PageHero from './PageHero.astro';
import ProjectGrid from './ProjectGrid.astro';
import FaqList from './FaqList.astro';
import CtaBand from './CtaBand.astro';

interface Props { entry: any; area: any; crumbs: { name: string; path: string }[] }
const { entry, area, crumbs } = Astro.props;
const d = entry.data;
---
<PageHero tag={`${area.data.name} / ${d.name}`} title={`${d.name} in ${area.data.name}`} lead={area.data.localNotes} crumbs={crumbs}>
  <p class="mt-5 max-w-[58ch] text-white/70">{d.answer}</p>
  <p class="mt-5"><a href={`/${entry.id}/`} class="inline-flex min-h-11 items-center font-semibold text-dusk underline decoration-dusk/50 underline-offset-8">All about {d.name.toLowerCase()}</a></p>
</PageHero>
<ProjectGrid service={entry.id} area={area.id} heading={`${d.name} in ${area.data.name}`} />
<FaqList faqs={d.faqs} />
<CtaBand service={d.name} area={area.data.name} />
