---
interface Props { crumbs: { name: string; path: string }[]; dark?: boolean }
const { crumbs, dark = false } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={['text-sm', dark ? 'text-white/65' : 'text-ink-soft']}>
  <ol class="flex flex-wrap items-center gap-2">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {i < crumbs.length - 1 ? <a href={c.path} class:list={['inline-flex min-h-11 items-center capitalize hover:underline', dark ? 'hover:text-dusk' : 'hover:text-brand']}>{c.name}</a> : <span aria-current="page" class:list={['capitalize font-medium', dark ? 'text-white' : 'text-ink']}>{c.name}</span>}
        {i < crumbs.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
