---
import { Icon } from 'astro-icon/components';

interface Props { href: string; variant?: 'accent' | 'wa' | 'ghost' | 'light'; icon?: string; class?: string; [k: string]: unknown }
const { href, variant = 'accent', icon = 'ph:arrow-up-right-bold', class: cls = '', ...rest } = Astro.props;
// accent = amber pill with the wire tail. wa = WhatsApp. ghost = outline. light = paper pill for dark backgrounds.
const styles = {
  accent: 'btn-tail bg-dusk text-night',
  wa: 'bg-wa text-white',
  ghost: 'border border-night text-night hover:bg-night hover:text-white',
  light: 'bg-paper text-night',
};
---
<a
  href={href}
  class:list={[
    'group inline-flex min-h-12 items-center gap-3 rounded-full py-2 pl-6 pr-2 font-semibold whitespace-nowrap',
    'transition-[transform,background-color,color] duration-300 ease-[var(--ease-out-quint)] active:scale-[0.98]',
    styles[variant], cls,
  ]}
  {...rest}
>
  <span><slot /></span>
  <span class="grid size-8 place-items-center rounded-full bg-black/10 transition-transform duration-300 ease-[var(--ease-out-quint)] group-hover:translate-x-0.5 group-hover:-translate-y-px">
    <Icon name={icon} class="size-4" />
  </span>
</a>
