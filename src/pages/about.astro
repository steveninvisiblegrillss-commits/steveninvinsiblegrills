---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { waLink, quoteMessage } from '../lib/whatsapp';
import photo from '../assets/images/projects/balcony-safety-net-installation-hyderabad.webp';

const wa = waLink(quoteMessage({ path: '/about/' }));
---
<Base title="About Steven Invisible Grills, Hyderabad" description="Steven Invisible Grills installs safety nets, pigeon nets, invisible grills and cloth hangers for Hyderabad homes. 10+ years, free installation." path="/about/">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 md:px-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h1 class="text-4xl font-bold leading-[1.05] md:text-5xl">Safety work done properly, across Hyderabad</h1>
      <div class="mt-6 grid max-w-[65ch] gap-4 text-lg text-ink-soft">
        <p>{site.name} installs balcony safety nets, pigeon nets, invisible grills and cloth hangers for homes, apartments and offices in Hyderabad and Secunderabad. We have {site.yearsClaim} of experience.</p>
        <p>From large commercial projects to a single apartment balcony, our team measures the space, gives a clear quote and installs with durable materials. Installation is free.</p>
        <p>Send a photo of your balcony or window on WhatsApp and we will tell you what fits.</p>
      </div>
      <div class="mt-8"><Button href={wa} variant="accent">Get a free quote</Button></div>
    </div>
    <div class="lg:col-span-5">
      <Picture src={photo} alt="Our installer next to a balcony safety net fitted on a curved railing in Hyderabad" widths={[480, 800]} sizes="(min-width: 1024px) 40vw, 100vw" formats={['avif']} fallbackFormat="webp" class="aspect-[3/4] w-full rounded-[var(--radius-card)] object-cover" />
    </div>
  </div>
  <CtaBand />
</Base>
