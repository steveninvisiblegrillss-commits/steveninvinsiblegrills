---
// About: a hero, worry flip cards (the worry on the front, what we do about it on the back), four pillars of confirmed facts, the job as a timeline wire, and recent work.
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { waLink, quoteMessage } from '../lib/whatsapp';
import photo from '../assets/images/projects/balcony-net-installer-with-fitted-net-hyderabad.webp';

const wa = waLink(quoteMessage({ path: '/about/' }));
const hubs = (await getCollection('services', (s) => s.data.kind === 'hub')).sort((a, b) => a.data.order - b.data.order);
const work = (await getCollection('projects')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');

// Every worry here is one the site already names on the matching service page.
const worries = [
  { front: 'A child near an open balcony', back: 'A safety net along the railing keeps the view open and the family safe.', to: '/children-safety-nets/', cta: 'Children safety nets' },
  { front: 'Pigeons nesting in a duct', back: 'A net closes the duct or balcony without blocking air or light.', to: '/pigeon-safety-nets/', cta: 'Pigeon safety nets' },
  { front: 'A window with no protection', back: 'Invisible grills guard the opening without a heavy look.', to: '/invisible-grills-for-windows/', cta: 'Window invisible grills' },
  { front: 'Nowhere to dry the clothes', back: 'A hanger fitted to the ceiling or balcony clears the floor.', to: '/cloth-hangers/', cta: 'Cloth hangers' },
];
const pillars = [
  { big: '10+', small: 'years', text: 'Experience installing for Hyderabad homes, apartments and offices.', icon: 'ph:calendar-check-duotone' },
  { big: 'Free', small: 'installation', text: 'We do not charge for installation. Send a photo and we quote the job.', icon: 'ph:wrench-duotone' },
  { big: 'Free', small: 'site visit', text: 'We visit and measure the openings properly before we quote the job.', icon: 'ph:ruler-duotone' },
  { big: '30', small: 'minutes', text: 'Send an enquiry and we call you within 30 minutes to confirm a visit.', icon: 'ph:phone-call-duotone' },
];
const steps = [
  { t: 'We look at your space', d: 'You send photos on WhatsApp. For most jobs we then visit to measure the openings properly.' },
  { t: 'You get a clear quote', d: 'The price depends on area, material and access. We explain what drives it before you decide.' },
  { t: 'Our team installs', d: 'We fix the frame or hooks, stretch the net or wires, and check every corner for gaps or slack.' },
  { t: 'We check it with you', d: 'Before we leave, we walk through the finished work so you know it is right.' },
];
---
<Base title="About Steven Invisible Grills, Hyderabad" description="Steven Invisible Grills installs safety nets, pigeon nets, invisible grills and cloth hangers for Hyderabad homes. 10+ years, free installation." path="/about/" flush darkHero>
  {/* 1. Hero */}
  <section class="wires bg-night text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pb-16 pt-28 md:px-8 md:pb-24 md:pt-36 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="sec-tag text-dusk">About us</p>
        <h1 class="mt-5 text-5xl md:text-7xl">Safety work done properly, <em class="em-accent">across Hyderabad</em></h1>
        <div class="mt-6 grid max-w-[60ch] gap-4 text-lg text-white/80">
          <p>{site.name} installs balcony safety nets, pigeon nets, invisible grills, cloth hangers and sports nets for homes, apartment communities and offices in Hyderabad and Secunderabad. We have {site.yearsClaim} of experience, and installation is free.</p>
          <p>Most of our work starts with a worry: a child near an open balcony, pigeons nesting in a duct, a window with no protection. The right product is usually simple once we see the space, so we ask for a photo first and recommend the option that fits.</p>
        </div>
        <div class="mt-8"><Button href={wa} variant="accent">Get a free quote</Button></div>
      </div>
      <div class="crop-marks">
        <Picture src={photo} alt="Our installer standing beside a balcony safety net fitted along a curved apartment railing" widths={[480, 800]} sizes="(min-width: 1024px) 35vw, 100vw" formats={['avif']} fallbackFormat="webp" loading="eager" class="aspect-[4/5] w-full border border-steel/40 object-cover" />
      </div>
    </div>
  </section>

  {/* 2. Worry flip cards: CSS only, a hidden checkbox holds the flipped state so it works by tap and keyboard */}
  <section class="bg-paper">
    <div class="grid-paper">
      <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
        <p class="sec-tag text-ink-soft">What brings people to us</p>
        <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">It usually starts with a <em class="em-brand">worry</em></h2>
        <p class="mono-tag mt-5 text-ink-soft">Tap a card to flip it</p>
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {worries.map((w, i) => (
            <li class="flip">
              <label class="flip-card relative block h-72 cursor-pointer">
                <input type="checkbox" class="peer sr-only" aria-label={`${w.front}. Show what we do about it`} />
                <span class="face absolute inset-0 flex flex-col justify-between border border-ink/25 bg-card p-6 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-dusk-text">
                  <span class="mono-tag text-dusk-text">Worry {pad(i + 1)}</span>
                  <span class="font-display text-3xl leading-tight">{w.front}</span>
                  <span class="mono-tag flex items-center gap-2 text-ink-soft"><Icon name="ph:arrows-clockwise-light" class="size-4" />Flip</span>
                </span>
                <span class="face back absolute inset-0 flex flex-col justify-between border border-night bg-night p-6 text-white">
                  <span class="mono-tag text-dusk">What we do</span>
                  <span class="text-lg text-white/85">{w.back}</span>
                  <a href={w.to} class="inline-flex min-h-11 items-center gap-2 font-semibold text-dusk">{w.cta} <Icon name="ph:arrow-right-light" class="size-5" /></a>
                </span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* 3. Four pillars: only facts the client has confirmed */}
  <section class="bg-night text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
      <p class="sec-tag text-dusk">What you can rely on</p>
      <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">Four things we <em class="em-accent">stand behind</em></h2>
      <ul class="mt-14 grid gap-px border border-steel/25 bg-steel/25 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p) => (
          <li class="bg-night p-7">
            <Icon name={p.icon} class="size-8 text-dusk" />
            <p class="mt-6 font-display text-6xl leading-none text-white">{p.big}</p>
            <p class="mono-tag mt-2 text-dusk">{p.small}</p>
            <p class="mt-4 text-white/70">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 4. Timeline wire */}
  <section class="bg-night-2 text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
      <p class="sec-tag text-dusk">How a job goes</p>
      <h2 class="mt-5 max-w-3xl text-4xl md:text-6xl">From your photo to a finished balcony</h2>
      <ol class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
        <span class="thread absolute bottom-0 left-[0.45rem] top-0 w-px bg-steel/50 md:bottom-auto md:left-0 md:right-0 md:top-[0.45rem] md:h-px md:w-auto" aria-hidden="true"></span>
        {steps.map((s, i) => (
          <li class="relative pl-9 md:pl-0 md:pt-9">
            <span class="absolute left-0 top-1 size-3.5 rotate-45 border border-dusk bg-night-2 md:top-0" aria-hidden="true"></span>
            <p class="mono-tag text-dusk">Step {pad(i + 1)}</p>
            <h3 class="mt-2 font-display text-2xl">{s.t}</h3>
            <p class="mt-2 text-white/70">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 5. What we install, and recent work */}
  <section class="bg-paper">
    <div class="grid-paper">
      <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
        <p class="sec-tag text-ink-soft">What we install</p>
        <ul class="mt-8 border-t border-ink/25">
          {hubs.map((h, i) => (
            <li class="border-b border-ink/25">
              <a href={`/${h.id}/`} class="group grid min-h-20 items-center gap-x-6 gap-y-1 py-5 md:grid-cols-[3rem_1fr_1.6fr_2rem]">
                <span class="mono-tag text-dusk-text">{pad(i + 1)}</span>
                <span class="font-display text-3xl group-hover:text-dusk-text">{h.data.name}</span>
                <span class="max-w-[55ch] text-ink-soft">{h.data.description}</span>
                <Icon name="ph:arrow-up-right-light" class="hidden size-6 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 md:block" />
              </a>
            </li>
          ))}
        </ul>

        {work.length > 0 && (
          <>
            <p class="sec-tag mt-20 text-ink-soft">Our work</p>
            <ul class="mt-8 grid gap-6 sm:grid-cols-3">
              {work.map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`} class="group block">
                    <span class="crop-marks crop-marks-ink block"><Picture src={p.data.photos[0].src} alt={p.data.photos[0].alt} widths={[400, 700]} sizes="(min-width: 640px) 33vw, 100vw" formats={['avif']} fallbackFormat="webp" class="aspect-[4/5] w-full border border-ink/20 object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.03]" /></span>
                    <span class="mt-4 block font-display text-xl leading-snug group-hover:text-dusk-text">{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/projects/" class="mt-10 inline-flex min-h-11 items-center gap-2 font-semibold text-dusk-text underline decoration-dusk-text/40 underline-offset-8">See all projects <Icon name="ph:arrow-right-light" class="size-5" /></a>
          </>
        )}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .flip { perspective: 1200px; }
  .flip-card .face { backface-visibility: hidden; transition: transform 700ms var(--ease-out-quint); }
  .flip-card .back { transform: rotateY(180deg); }
  .flip-card:has(input:checked) .face:not(.back) { transform: rotateY(-180deg); }
  .flip-card:has(input:checked) .back { transform: rotateY(0deg); }
  @media (hover: hover) {
    .flip-card:not(:has(input:checked)):hover .face:not(.back) { transform: rotateY(-180deg); }
    .flip-card:not(:has(input:checked)):hover .back { transform: rotateY(0deg); }
  }
  @media (prefers-reduced-motion: reduce) { .flip-card .face { transition: none; } }
</style>
