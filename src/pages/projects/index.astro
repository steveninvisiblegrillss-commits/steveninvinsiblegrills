---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
---
<Base title="Our projects: real installations in Hyderabad" description="Real safety net, invisible grill and sports net installations by Steven Invisible Grills. Filter by service and open any project for photos." path="/projects/">
  <div class="mx-auto max-w-7xl px-4 pt-10 md:px-8">
    <h1 class="text-5xl md:text-6xl">Our projects</h1>
    <p class="mt-4 max-w-[62ch] text-lg text-ink-soft">Every photo here is a job our team completed. Pick a service to see only that kind of work, then open a project for the full photo.</p>
    <ProjectGrid heading="" filters />
    <p class="max-w-[62ch] pb-16 text-ink-soft">Want something like this for your home? <a href="/contact/" class="font-semibold text-brand underline-offset-4 hover:underline">Send us a photo of your space</a> and we will tell you which option fits.</p>
  </div>
</Base>
