---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../config/site';
import { waLink, quoteMessage, telLink } from '../lib/whatsapp';

const wa = waLink(quoteMessage({ path: '/contact/' }));
const rows = [
  { icon: 'ph:phone-duotone', label: 'Call', value: site.phoneDisplay, href: telLink() },
  { icon: 'ph:whatsapp-logo-duotone', label: 'WhatsApp', value: site.phoneDisplay, href: wa },
  site.email && { icon: 'ph:envelope-simple-duotone', label: 'Email', value: site.email, href: `mailto:${site.email}` },
].filter(Boolean) as { icon: string; label: string; value: string; href: string }[];
---
<Base title="Contact Steven Invisible Grills, Hyderabad" description="Call or WhatsApp Steven Invisible Grills for safety nets, pigeon nets, invisible grills and cloth hangers in Hyderabad. Free installation." path="/contact/" service="" area="">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 pt-10 md:px-8 lg:grid-cols-2">
    <div>
      <h1 class="text-5xl md:text-6xl">Contact Steven Invisible Grills</h1>
      <p class="mt-5 max-w-[50ch] text-lg text-ink-soft">The fastest way to a quote is a photo of your balcony or window on WhatsApp.</p>
      <ul class="mt-8 grid gap-4">
        {rows.map((r) => (
          <li><a href={r.href} class="flex min-h-16 items-center gap-4 rounded-[var(--radius-card)] border border-line bg-card p-5 hover:border-brand">
            <Icon name={r.icon} class="size-8 text-brand" />
            <span><span class="block text-sm text-ink-soft">{r.label}</span><span class="font-semibold">{r.value}</span></span>
          </a></li>
        ))}
      </ul>

      <h2 class="mt-12 text-2xl font-bold">How we work with you</h2>
      <p class="mt-3 max-w-[60ch] text-ink-soft">We are a service-area business: our team comes to you across Hyderabad and Secunderabad, so there is no shop to visit. We confirm the visit time with you on WhatsApp or by phone. See the <a href="/areas/" class="font-semibold text-brand underline-offset-4 hover:underline">areas we serve</a>.</p>

      <h2 class="mt-10 text-2xl font-bold">What to send for a quick quote</h2>
      <ul class="mt-4 grid max-w-[60ch] list-disc gap-2 pl-5 text-ink-soft">
        <li>A photo of the balcony, window, duct or area</li>
        <li>Rough width and height, if you know them</li>
        <li>Your area or apartment community</li>
        <li>Whether children or pets use the space</li>
      </ul>
    </div>
    <div class="h-fit rounded-[var(--radius-card)] border border-line bg-card p-6 shadow-[var(--shadow-soft)] md:p-8">
      <h2 class="mb-5 text-2xl font-bold">Request a quote</h2>
      <QuoteForm />
    </div>
  </div>
  <div class="pb-16"></div>
</Base>
