---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqNode, breadcrumbNode } from '../lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const hubs = services.filter((s) => s.data.kind === 'hub');
const groups = hubs.map((h) => ({
  name: h.data.name,
  faqs: services.filter((s) => s.data.category === h.data.category).flatMap((s) => s.data.faqs),
}));
const all = groups.flatMap((g) => g.faqs);
---
<Base
  title="FAQ: Safety Nets and Invisible Grills, Hyderabad"
  description="Answers on pigeon nets, balcony safety nets, invisible grills and cloth hangers in Hyderabad: price, safety, installation and areas covered."
  path="/faq/"
  schema={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }]), faqNode(all, '/faq/')]}
>
  <div class="mx-auto max-w-7xl px-4 pt-14 md:px-8">
    <h1 class="text-4xl font-bold leading-[1.05] md:text-5xl">Frequently asked questions</h1>
    {groups.map((g) => <FaqList faqs={g.faqs} heading={g.name} />)}
  </div>
  <CtaBand />
</Base>
