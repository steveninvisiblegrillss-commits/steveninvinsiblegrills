---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { publishableAreas } from '../../lib/publish';
import { breadcrumbNode } from '../../lib/schema';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  const projects = await getCollection('projects');
  const ok = new Set(publishableAreas(areas.map((a) => ({ id: a.id, localNotes: a.data.localNotes })), projects.map((p) => ({ area: p.data.area.id, services: [] }))));
  return areas.filter((a) => ok.has(a.id)).map((a) => ({ params: { area: a.id }, props: { area: a } }));
}
const { area } = Astro.props;
const path = Astro.url.pathname;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Areas', path: '/areas/' }, { name: area.data.name, path }];
---
<Base title={`Safety nets and invisible grills in ${area.data.name}`} description={`Safety nets, pigeon nets, invisible grills and cloth hangers installed in ${area.data.name}, Hyderabad. See our work there and WhatsApp for a quote.`} path={path} schema={[breadcrumbNode(crumbs)]} area={area.data.name} flush darkHero>
  <PageHero tag={area.data.name} title={`Safety nets and invisible grills in ${area.data.name}`} lead={area.data.localNotes || undefined} crumbs={crumbs} />
  <ProjectGrid area={area.id} heading={`Our work in ${area.data.name}`} />
  <CtaBand area={area.data.name} />
</Base>
