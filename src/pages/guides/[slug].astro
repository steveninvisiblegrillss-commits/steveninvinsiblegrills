---
import { Picture, getImage } from 'astro:assets';
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { articleNode, breadcrumbNode } from '../../lib/schema';
import { waLink, quoteMessage } from '../../lib/whatsapp';

export async function getStaticPaths() {
  return (await getCollection('guides')).map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const d = guide.data;
const path = Astro.url.pathname;
const { Content } = await render(guide);
const services = await getEntries(d.services);
const img = await getImage({ src: d.hero, width: 1200, format: 'webp' });
const og = await getImage({ src: d.hero, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: d.title, path }];
const wa = waLink(quoteMessage({ path }));
---
<Base title={d.seoTitle} image={og.src} description={d.description} path={path} schema={[breadcrumbNode(crumbs), articleNode({ title: d.title, description: d.description, path, published: d.published, updated: d.updated, image: img.src })]} flush darkHero>
  <PageHero tag="Guide" title={d.title} lead={d.answer} crumbs={crumbs} narrow>
    <p class="mono-tag mt-6 text-white/55">By Steven Invisible Grills / Published {d.published.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
  </PageHero>
  <section class="bg-paper">
    <div class="grid-paper">
      <div class="mx-auto max-w-3xl px-4 py-16 md:px-8 md:py-24">
        <span class="crop-marks crop-marks-ink block"><Picture src={d.hero} alt={d.heroAlt} widths={[640, 1000, 1400]} sizes="(min-width: 768px) 48rem, 100vw" formats={['avif']} fallbackFormat="webp" loading="eager" class="aspect-[16/9] w-full border border-ink/20 object-cover" /></span>
        <div class="guide mt-12 grid gap-5 text-lg [&_a]:font-semibold [&_a]:text-night [&_a]:underline [&_a]:decoration-dusk-text [&_a]:underline-offset-4 [&_h2]:mt-8 [&_h2]:text-3xl [&_h2]:md:text-4xl [&_ul]:grid [&_ul]:gap-2"><Content /></div>
        <div class="mt-14 border border-ink/25 bg-card p-6 md:p-8">
          <p class="mono-tag text-dusk-text">Next step</p>
          <h2 class="mt-3 text-3xl md:text-4xl">Need a recommendation for your balcony?</h2>
          <p class="mt-3 text-ink-soft">Send a photo and we will suggest the right option.</p>
          <div class="mt-6"><Button href={wa} variant="accent">Get a free quote</Button></div>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3">
          {services.map((s) => <li><a href={`/${s.id}/`} class="mono-tag inline-flex min-h-11 items-center border border-night bg-night px-4 text-white transition-colors hover:bg-dusk hover:text-night">{s.data.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
