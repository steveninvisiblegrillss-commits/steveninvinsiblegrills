---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const guides = (await getCollection('guides')).sort((a, b) => +b.data.published - +a.data.published);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Guides: safety nets and invisible grills" description="Plain-English guides on invisible grills, balcony safety nets and pigeon nets for Hyderabad homes. Compare options and know what to check." path="/guides/" flush darkHero>
  <PageHero tag="Guides" title="Guides" lead="Short, practical answers to the questions people ask before they choose a net or an invisible grill." />
  <section class="bg-paper">
    <div class="grid-paper">
      <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
        <ul class="border-t border-ink/25">
          {guides.map((g, i) => (
            <li class="border-b border-ink/25">
              <a href={`/guides/${g.id}/`} class="group grid items-center gap-x-8 gap-y-4 py-8 md:grid-cols-[3rem_1fr_16rem_2rem]">
                <span class="mono-tag text-dusk-text">{pad(i + 1)}</span>
                <span>
                  <span class="block font-display text-3xl group-hover:text-dusk-text md:text-4xl">{g.data.title}</span>
                  <span class="mt-3 block max-w-[58ch] text-ink-soft">{g.data.description}</span>
                </span>
                <Picture src={g.data.hero} alt={g.data.heroAlt} widths={[400, 640]} sizes="256px" formats={['avif']} fallbackFormat="webp" class="aspect-[16/10] w-full border border-ink/20 object-cover grayscale transition-[filter] duration-500 group-hover:grayscale-0" />
                <Icon name="ph:arrow-up-right-light" class="hidden size-7 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 md:block" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
